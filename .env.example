NUXT_PUBLIC_RUNNER_MAPBOX_STYLE=mapbox://styles/your_username/your_style_id
NUXT_PUBLIC_SUPABASE_URL=https://favatadzmmqsdocrstti.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# Server only: uploads, anonymized extraction, private summaries and usage counters.
# Never use a NUXT_PUBLIC_ prefix. Resolved at request time, not baked into the build.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
# Choose a Responses model supporting strict JSON Schema for extraction/answers.
BRAIN_AI_MODEL=
# Public official/editorial knowledge: existing GEMINI_API_KEY generates vectors.
# Supabase pgvector stores 1536-dimensional normalized vectors; never mix models.
BRAIN_EMBEDDING_MODEL=gemini-embedding-001
# Private extraction only: set true only after confirming provider Zero Data Retention.
BRAIN_AI_ZERO_RETENTION=false
GEMINI_API_KEY=
# General chat and public trail knowledge. Server only; the existing key is enough locally.
# Override this model if your Google project uses a different supported text model.
GEMINI_MODEL=gemini-3.6-flash
# Welcome email only. Server-side; the Gmail app password is separate from account passwords.
# Supabase Auth keeps its own SMTP settings for password recovery.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
